#!/bin/sh

# Check if the correct number of arguments are provided
if [ "$#" -ne 5 ]; then
    echo "Usage: $0 <directory> <user> <group> <dir-permissions> <file-permissions>"
    exit 1
fi

# Assign input parameters to variables
DIR="$1"
USER="$2"
GROUP="$3"
DIR_PERMS="$4"
FILE_PERMS="$5"

# Check if the directory exists
if [ ! -d "$DIR" ]; then
    echo "Directory $DIR does not exist!"
    exit 1
fi

FAILED=0

# Only change entries that need repair. Apart from avoiding needless metadata
# writes on bind mounts, this makes the desired startup policy explicit.
# Do not make a failed repair fatal: on a root-squashed NFS export, container
# root is mapped to an anonymous user and is not allowed to chown or chmod.
if ! find "$DIR" -xdev \( ! -user "$USER" -o ! -group "$GROUP" \) \
    -exec chown "$USER:$GROUP" {} +; then
    echo "WARNING: could not repair all ownership under $DIR" >&2
    FAILED=1
fi

if ! find "$DIR" -xdev -type d ! -perm "$DIR_PERMS" -exec chmod "$DIR_PERMS" {} +; then
    echo "WARNING: could not repair all directory modes under $DIR" >&2
    FAILED=1
fi

if ! find "$DIR" -xdev -type f ! -perm "$FILE_PERMS" -exec chmod "$FILE_PERMS" {} +; then
    echo "WARNING: could not repair all file modes under $DIR" >&2
    FAILED=1
fi

if [ "$FAILED" -eq 0 ]; then
    echo "Permissions verified for directory: $DIR"
else
    echo "WARNING: permission repair was incomplete for $DIR; continuing so the configured PUID can access it." >&2
fi

exit 0

